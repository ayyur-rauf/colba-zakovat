# Nusxa oling: .env.example -> .env va qiymatlarni to'ldiring. .env git'ga qo'shilmaydi.
# Railway'da bu qiymatlar xizmatning "Variables" bo'limiga yoziladi (docs/RAILWAY.md).

DEBUG=1
# Serverda majburiy: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Bo'sh bo'lsa SQLite ishlatiladi. Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Fayllar (serverda doimiy disk — Railway Volume /data ga ulanadi)
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Birinchi bosh admin (har deploy oldidan tekshiriladi, takrorlanmaydi)
ADMIN_EMAIL=
ADMIN_NAME=Bosh admin
ADMIN_BRANCH=Bosh ofis
# ixtiyoriy: /admin/ (Django admin panel) uchun "admin" foydalanuvchisi paroli
ADMIN_PASSWORD=

# Pochta (kirish kodlari). Tavsiya: Brevo HTTP API — Railway'da SMTP portlari yopiq bo'lishi mumkin.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Colba platformasi <tasdiqlangan@email.uz>
# yoki SMTP:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Google: OAuth Client ID (web, android, ios) — vergul bilan
GOOGLE_CLIENT_IDS=
# BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=
