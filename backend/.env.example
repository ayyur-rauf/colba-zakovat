# Nusxa oling: .env.example -> .env va qiymatlarni to'ldiring. .env git'ga qo'shilmaydi.
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Bo'sh bo'lsa SQLite ishlatiladi. Serverda: postgres://user:parol@host:5432/colba
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Google Cloud Console -> OAuth Client ID (web, android, ios) — vergul bilan
GOOGLE_CLIENT_IDS=
# BotFather'dan olingan bot tokeni; botda /setdomain bilan sayt domenini ko'rsating
TELEGRAM_BOT_TOKEN=

# Email (SMTP). DEBUG=1 bo'lsa xatlar konsolga chiqadi.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Colba platformasi <noreply@colba.uz>
